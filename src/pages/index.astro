---
import BaseLayout from '../layouts/BaseLayout.astro';
import SEO from '../components/SEO.astro';
import StructuredData from '../components/StructuredData.astro';
import UpdatesFeed from '../components/UpdatesFeed.astro';
import { siteConfig } from '../config';
import { pagesConfig } from '../pages.config';
import { getPublished } from '../utils/collections';

const allProjects = await getPublished('projects');
const featuredProjects = allProjects
  .filter(project => project.data.featured === true)
  .sort((a, b) => b.data.year - a.data.year)
  .slice(0, 3);

// Get featured project IDs to exclude from latest posts
const featuredProjectIds = new Set(featuredProjects.map(p => p.id));
const updateMode = 'latest';
---

<BaseLayout>
  <SEO
    slot="head"
    title={`${siteConfig.author.name} - ${siteConfig.author.title}`}
    description={siteConfig.description}
    type="website"
    noSuffix
  />

  <StructuredData type="WebSite" />
  <StructuredData type="Person" />

  <div class="home-page">
    <section class="hero-band" aria-labelledby="hero-title">
      <div class="hero-inner">
        <h1 class="hero-title" id="hero-title">Lean scientific inference</h1>
        <div class="hero-side">
          <span class="hero-byline">
            {siteConfig.author.name}, {siteConfig.author.title}, {siteConfig.author.location}
          </span>
          <p class="hero-sub">
            Isolating the signal within the noise. I provide a transparent record of the decisions that transform complex research into disciplined AI applications.
          </p>
          <div class="hero-cta">
            <a href="/projects" class="btn btn--solid">Explore my projects</a>
            <a href="/publications" class="btn btn--line">Read my publications</a>
          </div>
        </div>
      </div>
    </section>

    <div class="home-body">
      <div class="home-col">
        <section class="home-prose" aria-labelledby="about-heading">
          <h2 class="home-label" id="about-heading">About me</h2>
          <p>{pagesConfig.home.description}</p>
        </section>
        <section class="home-prose" aria-labelledby="philosophy-heading">
          <h2 class="home-label" id="philosophy-heading">Work philosophy</h2>
          <p>
            Discovery depends on finding the right scale. I favor minimalism, matching methodology to the problem without unnecessary bloat. Efficiency matters to me, not only in code but in how we learn and adapt at the edge of research.
          </p>
          <p>
            I build by pruning the nonessential, ensuring each decision is as lean as the science requires. <mark>Every significant decision is documented, because effective engineers clarify their thinking, not just their output.</mark>
          </p>
          <p><a href="/journey" class="text-link">Explore my journey</a></p>
        </section>
      </div>

      <div class="home-col">
        <section aria-labelledby="featured-heading">
          <h2 class="home-label" id="featured-heading">Featured projects</h2>
          <ul class="home-rows" role="list">
            {featuredProjects.map((project) => (
              <li>
                <a href={`/projects/${project.id}`} class="home-row">
                  <span class="home-row-key">{project.data.year}</span>
                  <span>
                    <span class="home-row-title">{project.data.title}</span>
                    <span class="home-row-desc">{project.data.outcomeSummary}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
        <UpdatesFeed mode={updateMode} limit={3} excludedProjectIds={featuredProjectIds} />
      </div>
    </div>
  </div>

  <style>
    /* Hero band: graph paper with a major line every five minor cells. */
    .hero-band {
      background-color: var(--color-bg-content);
      background-image:
        linear-gradient(var(--color-border) 1px, transparent 1px),
        linear-gradient(90deg, var(--color-border) 1px, transparent 1px),
        linear-gradient(var(--color-border-subtle) 1px, transparent 1px),
        linear-gradient(90deg, var(--color-border-subtle) 1px, transparent 1px);
      background-size: 120px 120px, 120px 120px, 24px 24px, 24px 24px;
      background-position: -1px -1px;
      border-bottom: 1px solid var(--color-border);
    }

    .hero-inner {
      max-width: var(--max-width-page);
      margin: 0 auto;
      padding: 5rem 1.5rem 2.75rem;
      display: grid;
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
      gap: 2rem 3.5rem;
      align-items: end;
    }

    .hero-title {
      margin: 0;
      font-size: clamp(2.5rem, 6.4vw, 5rem);
      font-weight: 760;
      font-stretch: 120%;
      line-height: 0.96;
      letter-spacing: -0.03em;
      text-wrap: balance;
    }

    .hero-side {
      display: grid;
      gap: 1.25rem;
      padding: 1.5rem 1.75rem 1.75rem;
      border-top: 2px solid var(--color-text);
      background: var(--color-bg-content);
    }

    .hero-byline {
      font-size: 0.875rem;
      font-stretch: var(--stretch-label);
      color: var(--color-text-secondary);
    }

    .hero-sub {
      font-size: 1.0625rem;
      line-height: 1.55;
      max-width: 40ch;
    }

    .hero-cta {
      display: flex;
      flex-wrap: wrap;
      gap: 0.625rem;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      padding: 0 1rem;
      border-radius: 3px;
      font-weight: 600;
      font-size: 0.9375rem;
      text-decoration: none;
      transition: background-color var(--transition-fast), color var(--transition-fast), box-shadow var(--transition-fast);
    }

    .btn--solid {
      background: var(--color-text);
      color: var(--color-bg-content);
    }

    .btn--solid:hover {
      background: var(--color-accent);
      color: var(--color-bg-content);
    }

    .btn--line {
      color: var(--color-text);
      box-shadow: inset 0 0 0 1.5px var(--color-text);
    }

    .btn--line:hover {
      color: var(--color-accent);
      box-shadow: inset 0 0 0 1.5px var(--color-accent);
    }

    .home-body {
      max-width: var(--max-width-page);
      margin: 0 auto;
      padding: 3rem 1.5rem 4rem;
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 2.75rem 4rem;
    }

    .home-col {
      display: grid;
      gap: 2.25rem;
      align-content: start;
      min-width: 0;
    }

    /* Shared with UpdatesFeed, which renders inside the right column. */
    .home-body :global(.home-label) {
      margin: 0 0 0.5rem;
      font-size: 0.8125rem;
      font-weight: 600;
      font-stretch: var(--stretch-label);
      letter-spacing: 0.02em;
      line-height: 1.4;
      color: var(--color-text-secondary);
    }

    .home-prose p {
      max-width: 58ch;
      line-height: 1.65;
    }

    .home-prose p + p {
      margin-top: 0.875rem;
    }

    mark {
      background: linear-gradient(transparent 14%, var(--color-mark) 14%, var(--color-mark) 90%, transparent 90%);
      color: var(--color-mark-text);
      padding-inline: 2px;
      -webkit-box-decoration-break: clone;
      box-decoration-break: clone;
    }

    .text-link {
      font-weight: 600;
      text-decoration: underline;
      text-underline-offset: 4px;
      text-decoration-thickness: 1px;
    }

    .home-body :global(.home-rows) {
      list-style: none;
      margin: 0;
      padding: 0;
      border-bottom: 1px solid var(--color-border);
    }

    .home-body :global(.home-row) {
      display: grid;
      grid-template-columns: 4.75rem minmax(0, 1fr);
      gap: 0.875rem;
      padding: 0.8125rem 0;
      border-top: 1px solid var(--color-border);
      color: var(--color-text);
      text-decoration: none;
    }

    .home-body :global(.home-row:hover .home-row-title) {
      color: var(--color-accent);
    }

    .home-body :global(.home-row-key) {
      padding-top: 2px;
      font-size: 0.875rem;
      font-stretch: 72%;
      font-variant-numeric: tabular-nums;
      color: var(--color-text-secondary);
    }

    .home-body :global(.home-row-title) {
      display: block;
      font-weight: 640;
      line-height: 1.3;
      transition: color var(--transition-fast);
    }

    .home-body :global(.home-row-desc) {
      display: block;
      margin-top: 3px;
      font-size: 0.90625rem;
      line-height: 1.5;
      color: var(--color-text-secondary);
    }

    @media (max-width: 768px) {
      .hero-inner {
        grid-template-columns: minmax(0, 1fr);
        padding: 3rem 1rem 1.75rem;
      }

      .hero-side {
        padding: 1.25rem 1.25rem 1.5rem;
      }

      .home-body {
        grid-template-columns: minmax(0, 1fr);
        padding: 2.5rem 1rem 3rem;
      }
    }
  </style>
</BaseLayout>
