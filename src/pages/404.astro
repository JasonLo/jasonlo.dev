---
/**
 * 404 Not Found Page
 * 
 * Custom error page displayed when a requested page doesn't exist.
 * Features a minimal, centered layout with an icon, message, and
 * navigation back to the homepage.
 * 
 * Design:
 * - No header, navigation, or footer for focused experience
 * - Centered content with SVG icon
 * - Clear messaging about the error
 * - Single CTA button to return home
 * 
 * Route: /404 (automatically served for non-existent pages)
 * 
 * @page
 */

import { siteConfig } from '../config';
import AlertCircle from '../assets/icons/alert-circle.svg';

const pageTitle = '404 - Page Not Found';
---

<!DOCTYPE html>
<html lang={siteConfig.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="robots" content="noindex, nofollow" />
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    
    <!-- Inline critical styles -->
    <style>
      :root {
        /* Colors - Dark theme (Sumi & Hinoki) */
        --color-bg: #16150f;
        --color-text: #e7e1d2;
        --color-text-secondary: #a49d89;
        --color-text-muted: #938d78;
        --color-accent: #a6b475;
        --color-accent-hover: #b8c48a;
      }

      [data-theme="light"] {
        --color-bg: #e9e4d8;
        --color-text: #2c2a23;
        --color-text-secondary: #605b4c;
        --color-text-muted: #635d4c;
        --color-accent: #4f5b32;
        --color-accent-hover: #3c4626;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
        background: var(--color-bg);
        color: var(--color-text);
        line-height: 1.5;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 1.5rem;
      }

      .container {
        max-width: 500px;
        width: 100%;
        text-align: center;
      }

      .icon {
        width: 80px;
        height: 80px;
        margin: 0 auto 2rem;
        color: var(--color-text-muted);
        opacity: 0.6;
      }

      .error-code {
        font-size: 1rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--color-text-muted);
        margin-bottom: 1rem;
      }

      h1 {
        font-size: 2rem;
        font-weight: 700;
        letter-spacing: -0.02em;
        margin-bottom: 1rem;
        color: var(--color-text);
      }

      .description {
        font-size: 1.125rem;
        line-height: 1.7;
        color: var(--color-text-secondary);
        margin-bottom: 2.5rem;
      }

      .home-button {
        display: inline-block;
        padding: 0.875rem 2rem;
        background: var(--color-text);
        color: var(--color-bg);
        font-weight: 600;
        font-size: 1rem;
        text-decoration: none;
        border-radius: 6px;
        transition: opacity 0.2s ease;
      }

      .home-button:hover {
        opacity: 0.85;
      }

      .home-button:focus-visible {
        outline: 2px solid var(--color-accent);
        outline-offset: 2px;
      }

      @media (max-width: 640px) {
        .icon {
          width: 64px;
          height: 64px;
          margin-bottom: 1.5rem;
        }

        .error-code {
          font-size: 0.875rem;
        }

        h1 {
          font-size: 1.5rem;
        }

        .description {
          font-size: 1rem;
          margin-bottom: 2rem;
        }

        .home-button {
          padding: 0.75rem 1.75rem;
          font-size: 0.9375rem;
        }
      }
    </style>

    <!-- Theme initialization script -->
    <script is:inline>
      (function() {
        const stored = localStorage.getItem('theme');
        const theme = stored || (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>
  <body>
    <main class="container">
      <!-- 404 Icon -->
      <AlertCircle class="icon" aria-hidden="true" />

      <div class="error-code">404 Error</div>
      
      <h1>Page Not Found</h1>
      
      <p class="description">
        The page you're looking for doesn't exist or has been moved. Let's get you back on track.
      </p>

      <a href="/" class="home-button">Back to Home</a>
    </main>
  </body>
</html>
