---
import { getPublished } from '../utils/collections';
import { formatDate } from '../utils/date';
import { getEntryDate } from '../utils/entryDate';

interface Props {
  limit?: number;
  excludedProjectIds?: Set<string>;
  mode?: 'latest' | 'random';
}

const { limit = 3, excludedProjectIds = new Set(), mode = 'latest' } = Astro.props;


const [allJourney, allProjects, allPublications, allTools, allBlog] = await Promise.all([
  getPublished('journey'),
  getPublished('projects'),
  getPublished('publications'),
  getPublished('tools'),
  getPublished('blog'),
]);

// Unify all posts with a common structure
const allPosts = [
  ...allJourney.map(entry => ({
    type: 'journey' as const,
    date: getEntryDate(entry),
    title: entry.data.title,
    link: `/journey#${entry.id}`,
  })),
  ...allProjects
    .filter(project => !excludedProjectIds.has(project.id))
    .map(project => ({
      type: 'project' as const,
      date: getEntryDate(project),
      title: project.data.title,
      link: `/projects/${project.id}`,
    })),
  ...allPublications.map(pub => ({
    type: 'publication' as const,
    date: getEntryDate(pub),
    title: pub.data.title,
    link: pub.data.doi || '#',
  })),
  ...allTools.map(tool => ({
    type: 'tool' as const,
    date: getEntryDate(tool),
    title: tool.data.name,
    link: `/tools#${tool.id}`,
  })),
  ...allBlog.map(post => ({
    type: 'blog' as const,
    date: getEntryDate(post),
    title: post.data.title,
    link: `/blog/${post.id}`,
  })),
];

// Select posts based on mode
let selectedPosts;
if (mode === 'random') {
  // Fisher-Yates shuffle algorithm
  const shuffled = [...allPosts];
  for (let i = shuffled.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
  }
  selectedPosts = shuffled.slice(0, limit);
} else {
  // Latest mode - sort by date descending
  selectedPosts = allPosts
    .sort((a, b) => b.date.getTime() - a.date.getTime())
    .slice(0, limit);
}
---

<section class="latest-updates" aria-labelledby="updates-feed-heading">
  <h2 class="home-label" id="updates-feed-heading">{mode === 'random' ? 'Random updates' : 'Latest updates'}</h2>
  <ul class="home-rows" role="list">
    {selectedPosts.map((post) => {
      const isExternal = post.type === 'publication' && post.link !== '#';
      const linkProps = isExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {};
      return (
        <li>
          <a href={post.link} class="home-row" {...linkProps}>
            <time class="home-row-key" datetime={post.date.toISOString()}>{formatDate(post.date)}</time>
            <span>
              <span class="home-row-title">{post.title}</span>
              <span class="latest-type" data-type={post.type}>{post.type}</span>
              {isExternal && <span class="visually-hidden"> (opens in new tab)</span>}
            </span>
          </a>
        </li>
      );
    })}
  </ul>
</section>

<style>
  .latest-type {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 4px;
    font-size: 0.8125rem;
    font-stretch: var(--stretch-label);
    color: var(--color-text-secondary);
    text-transform: capitalize;
  }

  .latest-type::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--dot, var(--color-accent));
  }

  .latest-type[data-type='journey'] {
    --dot: var(--color-type-transition);
  }

  .latest-type[data-type='project'] {
    --dot: var(--color-accent);
  }

  .latest-type[data-type='publication'] {
    --dot: var(--color-type-learning);
  }

  .latest-type[data-type='tool'] {
    --dot: var(--color-type-tool);
  }

  .latest-type[data-type='blog'] {
    --dot: var(--color-type-blog);
  }
</style>
